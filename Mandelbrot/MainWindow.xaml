<Window x:Class="Mandelbrot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        
        Title="GPU Mandelbrot Set Generator"       
        
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Width="1024" 
        Height="768">
    
    <Grid ClipToBounds="True">
        <!-- RenderTransformOrigin centres the magnification the auto-zoom applies
             between finished frames, so the motion stays smooth when frames are slow. -->
        <Image Name="MandelbrotImage" Stretch="Fill" Margin="0,0,0,0"
               RenderTransformOrigin="0.5,0.5" />

        <TextBlock Name="FpsLabel"
               Foreground="CornflowerBlue"
               FontFamily="Consolas"
               FontSize="24"
               FontWeight="Bold"
               Background="Transparent"
               Margin="10"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               />

        <TextBlock Name="ResLabel"
               Foreground="CornflowerBlue"
               FontFamily="Consolas"
               FontSize="24"
               FontWeight="Bold"
               Background="Transparent"
               Margin="10"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               />

    </Grid>

</Window>

